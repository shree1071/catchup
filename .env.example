# ==============================================================================
# CatchUp: Intelligent Communication Triage System - Environment Configuration
# IEEE Computational Intelligence Society | BMSIT&M Hackathon 2026
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary AI Provider Selector
# ------------------------------------------------------------------------------
# Choose the default inference engine:
#   - 'groq'   : Cloud LPU acceleration (sub-second latency, open weights)
#   - 'ollama' : 100% Local-First Edge (Air-gapped, zero data leaves workstation)
VITE_DEFAULT_AI_PROVIDER=groq

# ------------------------------------------------------------------------------
# 2. Groq Cloud LPU Inference (Optional if running 100% local with Ollama)
# ------------------------------------------------------------------------------
# Get your free ultra-fast LPU API key at: https://console.groq.com
VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_GROQ_MODEL=openai/gpt-oss-20b

# ------------------------------------------------------------------------------
# 3. Local-First Edge AI: Ollama (BYOM - Bring Your Own Model)
# ------------------------------------------------------------------------------
# Run 100% locally with zero cloud API keys and total data privacy.
# Install Ollama: https://ollama.com
#
# Popular edge models for communication triage:
#   ollama run llama3.2          # 3B Edge (Fastest, ultra-lightweight ~2.0 GB)
#   ollama run deepseek-r1:8b    # Reasoning powerhouse with chain-of-thought
#   ollama run llama3.1          # 8B Generalist (High capacity ~4.7 GB)
#   ollama run mistral           # 7B Dense summarizer (~4.1 GB)
#   ollama run qwen2.5:7b        # Multilingual & code specialist (~4.5 GB)
#   ollama run phi3:mini         # Microsoft 3.8B edge model (~2.2 GB)
#
# Base URL for Ollama service daemon (default port is 11434):
# Note: Vite dev server automatically proxies /api/ollama to bypass browser CORS!
VITE_OLLAMA_BASE_URL=http://localhost:11434

# Default local model tag to invoke:
VITE_OLLAMA_MODEL=llama3.2

# ------------------------------------------------------------------------------
# 4. Model Context Protocol (MCP) & Composio Tooling Bridge
# ------------------------------------------------------------------------------
# Connects CatchUp to Slack workspaces, Microsoft Teams, and Notion databases.
VITE_COMPOSIO_API_KEY=
